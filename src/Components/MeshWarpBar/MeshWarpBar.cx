using System;
using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>Floating controls for the interactive mesh warp.</summary>
public sealed class MeshWarpBar : Component
{
    /// <inheritdoc/>
    public override Node Render()
    {
        PaintSession editor = UseContext(EditorContext.Value);
        if (!editor.IsMeshWarpOpen)
        {
            return <span />;
        }

        return <div className="mesh-warp-bar">
            <span className="mesh-warp-title">{Text("Mesh Warp")}</span>
            <span className="mesh-warp-layer" Title="Layer being mesh-warped">
                {Ui.Icon(Icons.Flatten, "mesh-warp-layer-icon")}
                <span className="mesh-warp-layer-name">{Text(editor.MeshWarpLayer?.Name ?? "None")}</span>
            </span>
            <span className={editor.MeshWarpLayerEmpty ? "mesh-warp-note is-warning" : "mesh-warp-note"}>
                {Text(editor.MeshWarpLayerEmpty
                    ? "This layer is empty. Pick one with pixels."
                    : "Drag the nine points on the canvas.")}
            </span>
            {<Button Label="Reset" title="Clear every point offset" onClick={() => { editor.ResetMeshWarp(); editor.Refresh?.Invoke(); }} />}
            {<Button Label="Cancel" title="Restore the original pixels" onClick={() => { editor.CancelMeshWarp(); editor.Refresh?.Invoke(); }} />}
            {<Button Label="Done" title="Keep the warped layer" onClick={() => { editor.CommitMeshWarp(); editor.Refresh?.Invoke(); }} />}
        </div>;
    }
}