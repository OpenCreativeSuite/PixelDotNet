using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>
/// A labelled value control with previous/next buttons for stepping through a fixed list.
/// </summary>
/// <example>
/// <code>
/// &lt;Stepper Value={LabelOf(active.Blend)} title="Blend mode of the active layer" Previous={() => Cycle(editor, -1)} Next={() => Cycle(editor, 1)} /&gt;
/// </code>
/// </example>
public class StepperProps : Props
{
    /// <summary>Gets or sets the displayed value text.</summary>
    /// <value>The value. Defaults to an empty string.</value>
    public string Value { get; set; } = "";

    /// <summary>Gets or sets the previous-step handler.</summary>
    /// <value>An action, or <see langword="null"/>.</value>
    public Action? Previous { get; set; }

    /// <summary>Gets or sets the next-step handler.</summary>
    /// <value>An action, or <see langword="null"/>.</value>
    public Action? Next { get; set; }
}

/// <summary>
/// A stepper component. See <see cref="StepperProps"/> for the available props.
/// </summary>
public sealed class Stepper : Component<StepperProps>
{
    /// <inheritdoc/>
    public override Node Render()
    {
        StepperProps props = Props;
        return <div className="stepper" title={props.Title}>
            <button className="stepper-btn" title="Previous" onClick={() => props.Previous?.Invoke()}>
                {Ui.Icon(Icons.Previous, "stepper-glyph")}
            </button>
            <span className="stepper-value">{Text(props.Value)}</span>
            <button className="stepper-btn" title="Next" onClick={() => props.Next?.Invoke()}>
                {Ui.Icon(Icons.Next, "stepper-glyph")}
            </button>
        </div>;
    }
}