using System.Collections.Generic;
using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>
/// The undo history panel: lists undo steps oldest-first, oldest at top, with
/// click-to-travel. Future (redo) steps are visually muted.
/// </summary>
public sealed class HistoryPanel : Component
{
    /// <inheritdoc/>
    public override Node Render()
    {
        PaintSession editor = UseContext(EditorContext.Value);
        IReadOnlyList<string> steps = editor.HistorySteps;
        int current = editor.HistoryIndex;
        List<Node> rows = [];

        for (int i = 0; i < steps.Count; i++)
        {
            int index = i;
            bool future = index > current;
            rows.Add(<button className={index == current ? "history-item is-active" : future ? "history-item is-future" : "history-item"}
                key={index.ToString()}
                onClick={() => editor.GoToHistory(index)}>
                <span className="history-dot" />
                <span className="history-name">{Text(steps[index])}</span>
                <span className="history-index">{Text((index + 1).ToString())}</span>
            </button>);
        }

        return F(
            <Section Title="History" Children={new Node[] { <div className="history-list">{rows.ToArray()}</div> }} />,
            <span className="panel-note">
                {Text("Click a step to travel back or forwards. New edits drop the redo steps below the current one.")}
            </span>);
    }
}