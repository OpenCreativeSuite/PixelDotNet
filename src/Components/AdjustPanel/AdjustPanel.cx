using System;
using System.Collections.Generic;
using Donkeh.UILab;
using Donkeh.Windowing;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>
/// Live adjustments for the active layer: a histogram, tone sliders and the
/// one-shot colour operations.
/// </summary>
/// <remarks>
/// The sliders rebuild the layer from the snapshot taken on the first change, so
/// dragging never compounds and the result is exactly the slider values applied to
/// the original pixels.
/// </remarks>
public sealed class AdjustPanel : Component
{
    private const int HistogramWidth = 288;
    private const int HistogramHeight = 68;
    private const int CurveWidth = 288;
    private const int CurveHeight = 148;

    private int _curveDrag = -1;

    /// <inheritdoc/>
    public override Node Render()
    {
        PaintSession editor = UseContext(EditorContext.Value);
        PaintLayer active = editor.Document.Active;
        bool locked = active.Locked;

        if (active.IsAdjustment)
        {
            return F(
                HistogramSection(editor),
                AdjustmentControls(editor, active),
                <span className="panel-note">
                    {Text("This adjustment layer affects the visible layers below it, optionally through its mask and selection.")}
                </span>);
        }

        return F(
            <Section Title="Histogram" Children={new Node[] {
                <div className="histogram-frame">
                    {<canvas className="histogram" attributes={Ui.Size(HistogramWidth, HistogramHeight)} onCanvasDraw={(Action<CanvasContext>)(context => DrawHistogram(context, editor))} />}
                    <div className="histogram-ramp" />
                </div>
            }} />,

            <Section Title="Tone" Children={new Node[] {
                <Slider Label="Brightness" Value={editor.AdjustBrightness} Min={-100f} Max={100f} Step={1f} Suffix={string.Empty}
                    onInput={value => { editor.AdjustBrightness = Ui.Parse(value, -100f, 100f); Apply(editor); }} />,
                <Slider Label="Contrast" Value={editor.AdjustContrast} Min={-100f} Max={100f} Step={1f} Suffix={string.Empty}
                    onInput={value => { editor.AdjustContrast = Ui.Parse(value, -100f, 100f); Apply(editor); }} />,
                <div className="section-split" />,
                <Slider Label="Hue" Value={editor.AdjustHue} Min={-180f} Max={180f} Step={1f} Suffix="°"
                    onInput={value => { editor.AdjustHue = Ui.Parse(value, -180f, 180f); Apply(editor); }} />,
                <Slider Label="Saturation" Value={editor.AdjustSaturation} Min={-100f} Max={100f} Step={1f} Suffix={string.Empty}
                    onInput={value => { editor.AdjustSaturation = Ui.Parse(value, -100f, 100f); Apply(editor); }} />,
                <Slider Label="Lightness" Value={editor.AdjustLightness} Min={-100f} Max={100f} Step={1f} Suffix={string.Empty}
                    onInput={value => { editor.AdjustLightness = Ui.Parse(value, -100f, 100f); Apply(editor); }} />,
                <div className="row">
                    {Ui.Button("Reset", "Return the sliders to neutral", editor.ResetAdjustments, editor.HasAdjustments)}
                </div>
            }} />,

            <Section Title="Levels" Children={new Node[] {
                <Slider Label="Black" Value={editor.LevelsBlack} Min={0f} Max={254f} Step={1f} Suffix={string.Empty}
                    onInput={value => { editor.LevelsBlack = Ui.Parse(value, 0f, 254f); Apply(editor); }} />,
                <Slider Label="White" Value={editor.LevelsWhite} Min={1f} Max={255f} Step={1f} Suffix={string.Empty}
                    onInput={value => { editor.LevelsWhite = Ui.Parse(value, 1f, 255f); Apply(editor); }} />,
                <Slider Label="Midtone" Value={editor.LevelsGamma * 100f} Min={10f} Max={500f} Step={1f} Suffix=" %"
                    onInput={value => { editor.LevelsGamma = Ui.Parse(value, 10f, 500f) / 100f; Apply(editor); }} />,
                <div className="row">
                    {Ui.Button("Reset Levels", "Return the levels controls to neutral", editor.ResetLevels, editor.HasLevels)}
                </div>
            }} />,

            <Section Title="Curves" Children={new Node[] {
                <canvas className="curve-editor"
                    attributes={Ui.Size(CurveWidth, CurveHeight)}
                    onPointerDown={(x, y) => CurveDown(editor, x, y)}
                    onPointerMove={(x, y) => CurveMove(editor, x, y)}
                    onPointerUp={(x, y) => CurveUp(editor)}
                    onContextMenu={menu => CurveRemove(editor, menu.X, menu.Y)}
                    onCanvasDraw={(Action<CanvasContext>)(context => DrawCurve(context, editor))} />,
                <div className="row">
                    {Ui.Button("Reset Curve", "Return the tone curve to a straight line", () =>
                    {
                        editor.ResetActiveCurve();
                        ApplyCurveChange(editor);
                    }, editor.HasCurve)}
                </div>
            }} />,

            <Section Title="Adjustment Layer" Children={new Node[] {
                <div className="row">
                    {Ui.Button("Levels Layer", "Add a non-destructive Levels adjustment layer", () =>
                    {
                        editor.AddAdjustmentLayer(AdjustmentKind.Levels);
                        editor.Refresh?.Invoke();
                    })}
                    {Ui.Button("Curves Layer", "Add a non-destructive Curves adjustment layer", () =>
                    {
                        editor.AddAdjustmentLayer(AdjustmentKind.Curves);
                        editor.Refresh?.Invoke();
                    })}
                </div>
            }} />,

            <Section Title="Colour" Children={new Node[] {
                <div className="row">
                    {Ui.ButtonIcon(Icons.Invert, "Invert", "Invert the layer or the marquee", editor.Invert, !locked)}
                    {Ui.ButtonIcon(Icons.Desaturate, "Mono", "Remove colour from the layer or the marquee", editor.Desaturate, !locked)}
                </div>,
                <div className="row">
                    {Ui.ButtonIcon(Icons.Flatten, "Flatten Image", "Merge every visible layer into one", editor.FlattenImage)}
                </div>
            }} />,

            <span className="panel-note">
                {Text("Sliders edit the active layer, or only the marquee when there is a selection.")}
            </span>);
    }

    /// <summary>Pushes a slider change into the layer and re-renders the panels.</summary>
    private static void Apply(PaintSession editor)
    {
        editor.TouchAdjustments();
        editor.Refresh?.Invoke();
    }

    /// <summary>Draws the shared histogram block.</summary>
    private static Node HistogramSection(PaintSession editor) =>
        <Section Title="Histogram" Children={new Node[] {
            <div className="histogram-frame">
                {<canvas className="histogram" attributes={Ui.Size(HistogramWidth, HistogramHeight)} onCanvasDraw={(Action<CanvasContext>)(context => DrawHistogram(context, editor))} />}
                <div className="histogram-ramp" />
            </div>
        }} />;

    /// <summary>Builds the editor for the active adjustment layer.</summary>
    private Node AdjustmentControls(PaintSession editor, PaintLayer layer)
    {
        if (layer.Adjustment == AdjustmentKind.Curves)
        {
            return <Section Title="Curves Adjustment" Children={new Node[] {
                <canvas className="curve-editor"
                    attributes={Ui.Size(CurveWidth, CurveHeight)}
                    onPointerDown={(x, y) => CurveDown(editor, x, y)}
                    onPointerMove={(x, y) => CurveMove(editor, x, y)}
                    onPointerUp={(x, y) => CurveUp(editor)}
                    onContextMenu={menu => CurveRemove(editor, menu.X, menu.Y)}
                    onCanvasDraw={(Action<CanvasContext>)(context => DrawCurve(context, editor))} />,
                <div className="row">
                    {Ui.Button("Reset Curve", "Return the adjustment curve to neutral", () =>
                    {
                        editor.ResetActiveCurve();
                        ApplyCurveChange(editor);
                    })}
                </div>
            }} />;
        }

        return <Section Title="Levels Adjustment" Children={new Node[] {
            <Slider Label="Black" Value={layer.AdjustmentBlack} Min={0f} Max={254f} Step={1f} Suffix={string.Empty}
                onInput={value => { editor.SetAdjustmentLevels(Ui.Parse(value, 0f, 254f), layer.AdjustmentWhite, layer.AdjustmentGamma); editor.Refresh?.Invoke(); }} />,
            <Slider Label="White" Value={layer.AdjustmentWhite} Min={1f} Max={255f} Step={1f} Suffix={string.Empty}
                onInput={value => { editor.SetAdjustmentLevels(layer.AdjustmentBlack, Ui.Parse(value, 1f, 255f), layer.AdjustmentGamma); editor.Refresh?.Invoke(); }} />,
            <Slider Label="Midtone" Value={layer.AdjustmentGamma * 100f} Min={10f} Max={500f} Step={1f} Suffix=" %"
                onInput={value => { editor.SetAdjustmentLevels(layer.AdjustmentBlack, layer.AdjustmentWhite, Ui.Parse(value, 10f, 500f) / 100f); editor.Refresh?.Invoke(); }} />,
            <div className="row">
                {Ui.Button("Reset Levels", "Return the adjustment to neutral", () =>
                {
                    editor.ResetAdjustmentLevels();
                    editor.Refresh?.Invoke();
                })}
            </div>
        }} />;
    }

    // DrawCurve, CurveLine, DrawHistogram, CurvePosition, CurveDown/Move/Up/Remove, ApplyCurveChange unchanged
    /// <summary>Maps canvas coordinates into curve space, with y pointing up.</summary>
    private static (float X, float Y) CurvePosition(float x, float y) => (
        Math.Clamp(x / (CurveWidth - 1f), 0f, 1f),
        Math.Clamp(1f - (y / (CurveHeight - 1f)), 0f, 1f));

    /// <summary>Selects or adds a curve point and starts dragging it.</summary>
    private void CurveDown(PaintSession editor, float x, float y)
    {
        (float nx, float ny) = CurvePosition(x, y);
        int index = editor.FindActiveCurvePoint(nx, ny, 14f / CurveWidth);
        if (index < 0)
        {
            index = editor.AddActiveCurvePoint(nx, ny);
        }

        _curveDrag = index;
        editor.MoveActiveCurvePoint(index, nx, ny);
        ApplyCurveChange(editor);
    }

    /// <summary>Drags the active curve point.</summary>
    private void CurveMove(PaintSession editor, float x, float y)
    {
        if (_curveDrag < 0)
        {
            return;
        }

        (float nx, float ny) = CurvePosition(x, y);
        editor.MoveActiveCurvePoint(_curveDrag, nx, ny);
        ApplyCurveChange(editor);
    }

    /// <summary>Ends the curve drag.</summary>
    private void CurveUp(PaintSession editor) => _curveDrag = -1;

    /// <summary>Removes the curve point under a right-click.</summary>
    private static void CurveRemove(PaintSession editor, float x, float y)
    {
        (float nx, float ny) = CurvePosition(x, y);
        int index = editor.FindActiveCurvePoint(nx, ny, 14f / CurveWidth);
        if (index < 0)
        {
            return;
        }

        editor.RemoveActiveCurvePoint(index);
        ApplyCurveChange(editor);
    }

    /// <summary>Applies the curve change to the destructive or adjustment target.</summary>
    private static void ApplyCurveChange(PaintSession editor)
    {
        if (editor.ActiveAdjustmentLayer is { Adjustment: AdjustmentKind.Curves })
        {
            editor.TouchAdjustmentLayer();
        }
        else
        {
            editor.TouchAdjustments();
        }

        editor.Refresh?.Invoke();
    }

    /// <summary>Draws the curve editor grid, identity line and control points.</summary>
    private static void DrawCurve(CanvasContext context, PaintSession editor)
    {
        context.Clear(0xFF101116);

        for (int i = 1; i < 4; i++)
        {
            float x = CurveWidth / 4f * i;
            float y = CurveHeight / 4f * i;
            context.FillRect(x, 0f, 1f, CurveHeight, 0x18FFFFFF);
            context.FillRect(0f, y, CurveWidth, 1f, 0x18FFFFFF);
        }

        CurveLine(context, 0f, CurveHeight, CurveWidth, 0f, 0x30FFFFFF);

        IReadOnlyList<(float X, float Y)> points = editor.ActiveCurvePoints;
        for (int index = 0; index + 1 < points.Count; index++)
        {
            CurveLine(
                context,
                points[index].X * CurveWidth,
                (1f - points[index].Y) * CurveHeight,
                points[index + 1].X * CurveWidth,
                (1f - points[index + 1].Y) * CurveHeight,
                0xFFFF2D87);
        }

        foreach ((float x, float y) in points)
        {
            float px = (x * CurveWidth) - 4f;
            float py = ((1f - y) * CurveHeight) - 4f;
            context.FillRect(px, py, 9f, 9f, 0xFF05060A);
            context.FillRect(px + 1f, py + 1f, 7f, 7f, 0xFFFFFFFF);
        }
    }

    /// <summary>Draws one thin curve segment as a run of rectangles.</summary>
    private static void CurveLine(CanvasContext context, float x0, float y0, float x1, float y1, uint color)
    {
        float dx = x1 - x0;
        float dy = y1 - y0;
        int steps = Math.Max(1, (int)MathF.Ceiling(MathF.Sqrt((dx * dx) + (dy * dy))));
        for (int step = 0; step <= steps; step++)
        {
            float t = step / (float)steps;
            context.FillRect(x0 + (dx * t), y0 + (dy * t), 1.5f, 1.5f, color);
        }
    }

    /// <summary>Draws the composited luminance histogram with a square-root scale.</summary>
    private static void DrawHistogram(CanvasContext context, PaintSession editor)
    {
        const int Buckets = 64;
        const float Width = HistogramWidth;
        const float Height = HistogramHeight;

        context.Clear(0xFF101116);
        int[] counts = editor.Histogram;

        int peak = 1;
        for (int i = 0; i < Buckets; i++)
        {
            peak = Math.Max(peak, counts[i]);
        }

        float columnWidth = Width / Buckets;
        for (int i = 0; i < Buckets; i++)
        {
            float height = (Height - 6f) * MathF.Sqrt(counts[i] / (float)peak);
            if (height < 0.75f)
            {
                continue;
            }

            // Brighter tones on the right, matching the ramp under the plot.
            int shade = 96 + (i * 150 / (Buckets - 1));
            context.FillRect(i * columnWidth, Height - height - 2f, columnWidth + 0.5f, height, Rgba.FromRgb((byte)shade, (byte)shade, (byte)Math.Min(255, shade + 8)));
        }

        for (int i = 1; i < 4; i++)
        {
            context.FillRect(0f, (Height / 4f * i), Width, 1f, 0x14FFFFFF);
        }
    }
}