using Donkeh.Hosting;
using Donkeh.UILab;
using PixelDotNet.Components;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet;

/// <summary>
/// The application root component. Owns the paint session and publishes it to every
/// panel via <see cref="EditorContext"/>.
/// </summary>
/// <remarks>
/// <para>
/// The session lives in a <see cref="Ref{T}"/> so strokes never re-render the tree;
/// a counter in hook state is bumped by <see cref="PaintSession.Refresh"/> when UI
/// that mirrors the model needs to catch up.
/// </para>
/// <para>
/// The root element binds a ref so its measured bounds can drive
/// <see cref="PaintSession.ViewportWidth"/> and <see cref="PaintSession.ViewportHeight"/>.
/// Keyboard shortcuts are attached to the root so any focused control forwards them.
/// </para>
/// </remarks>
[AppRoot(
    Width = 1440,
    Height = 900,
    Title = "PixelDotNet",
    ClearColor = 0xFF0B0C10,
    MinWidth = 420,
    MinHeight = 560)]
public sealed class App : Component
{
    /// <inheritdoc/>
    public override Node Render()
    {
        Ref<PaintSession> reference = UseRef<PaintSession>();
        PaintSession? session = reference.Value;
        if (session is null)
        {
            session = PaintSession.CreateDemo();
            reference.Value = session;
        }

        PaintSession editor = session;
        var tick = StateWithUpdate(0);
        editor.Refresh = () => tick.Update(value => value + 1);

        Ref<ElementNode> rootRef = UseRef<ElementNode>();
        ElementNode root = (ElementNode)Div(new()
        {
            ClassName = "app",
            OnKeyDown = key => Viewport.HandleShortcut(editor, key),
        },
            <OptionsBar />,
            <ToolRail />,
            <Viewport />,
            <SidePanel />,
            <StatusBar />,
            <MenuBar />,
            Show(editor.IsFontMenuOpen, Div(new()
            {
                ClassName = "font-backdrop",
                OnClick = () =>
                {
                    editor.CloseFontMenu();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsFontMenuOpen, <FontPicker />),
            Show(editor.IsTextFxOpen, Div(new()
            {
                ClassName = "font-backdrop",
                OnClick = () =>
                {
                    editor.CloseTextFx();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsTextFxOpen, <TextFxPanel />),
            Show(editor.Tip is not null, <TooltipOverlay />),
            Show(editor.OpenHelp is not null, Div(new()
            {
                ClassName = "help-backdrop",
                OnClick = () =>
                {
                    editor.CloseHelp();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.OpenHelp is not null, <HelpModal />),
            Show(editor.IsFileDialogOpen, Div(new()
            {
                ClassName = "file-backdrop",
                OnClick = () =>
                {
                    editor.CloseFileDialog();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsFileDialogOpen, <FileDialog />),
            Show(editor.IsResizeOpen, Div(new()
            {
                ClassName = "resize-backdrop",
                OnClick = () =>
                {
                    editor.CloseResizeDialog();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsResizeOpen, <ResizeDialog />),
            Show(editor.IsBatchOpen, Div(new()
            {
                ClassName = "resize-backdrop",
                OnClick = () =>
                {
                    editor.CloseBatchDialog();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsBatchOpen, <BatchDialog />),
            Show(editor.IsLayerMenuOpen, Div(new()
            {
                ClassName = "file-menu-backdrop",
                OnClick = () => editor.CloseLayerMenu(),
            })),
            Show(editor.IsLayerMenuOpen, <LayerMenu />),
            Show(editor.IsLayerStyleOpen, Div(new()
            {
                ClassName = "resize-backdrop",
                OnClick = () =>
                {
                    editor.CloseLayerStyleDialog();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsLayerStyleOpen, <LayerStyleDialog />),
            Show(editor.IsColourToolsOpen, Div(new()
            {
                ClassName = "resize-backdrop",
                OnClick = () =>
                {
                    editor.CloseColourToolsDialog();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsColourToolsOpen, <ColourToolsDialog />),
            Show(editor.IsPerspectiveOpen, Div(new()
            {
                ClassName = "resize-backdrop",
                OnClick = () =>
                {
                    editor.CancelPerspective();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsPerspectiveOpen, <PerspectiveDialog />),
            Show(editor.IsMeshWarpOpen, <MeshWarpBar />),
            Show(editor.IsSmartTransformOpen, Div(new()
            {
                ClassName = "resize-backdrop",
                OnClick = () =>
                {
                    editor.CancelSmartTransform();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsSmartTransformOpen, <SmartObjectDialog />),
            Show(editor.IsShapeEditOpen, Div(new()
            {
                ClassName = "resize-backdrop",
                OnClick = () =>
                {
                    editor.CancelShapeEdit();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsShapeEditOpen, <ShapeEditDialog />),
            Show(editor.IsTextEditOpen, Div(new()
            {
                ClassName = "resize-backdrop",
                OnClick = () =>
                {
                    editor.CancelTextEdit();
                    editor.Refresh?.Invoke();
                },
            })),
            Show(editor.IsTextEditOpen, <TextEditDialog />));
        root.BindRef(rootRef);
        if (rootRef.Value is { Width: > 0, Height: > 0 } bounds)
        {
            editor.ViewportWidth = bounds.Width;
            editor.ViewportHeight = bounds.Height;
        }

        return Provider(EditorContext.Value, editor, root);
    }
}