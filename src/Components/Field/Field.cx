using System.Globalization;
using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>
/// A labelled inline slider (range input) sized for the options bar.
/// </summary>
/// <example>
/// <code>
/// &lt;Field Label="Size" Value={editor.BrushSize} Min={1f} Max={120f} Step={1f} Suffix=" px" onInput={value => editor.BrushSize = Ui.Parse(value, 1f, 120f)} /&gt;
/// </code>
/// </example>
public class FieldProps : Props
{
    /// <summary>Gets or sets the field label.</summary>
    /// <value>The label. Defaults to an empty string.</value>
    public string Label { get; set; } = "";

    /// <summary>Gets or sets the current value.</summary>
    /// <value>The value.</value>
    public float Value { get; set; }

    /// <summary>Gets or sets the minimum value.</summary>
    /// <value>The minimum.</value>
    public float Min { get; set; }

    /// <summary>Gets or sets the maximum value.</summary>
    /// <value>The maximum.</value>
    public float Max { get; set; }

    /// <summary>Gets or sets the step increment.</summary>
    /// <value>The step. Defaults to 1.</value>
    public float Step { get; set; } = 1f;

    /// <summary>Gets or sets the suffix appended to the displayed value.</summary>
    /// <value>The suffix. Defaults to an empty string.</value>
    public string Suffix { get; set; } = "";

}

/// <summary>
/// A field component. See <see cref="FieldProps"/> for the available props.
/// </summary>
public sealed class Field : Component<FieldProps>
{
    /// <inheritdoc/>
    public override Node Render()
    {
        FieldProps props = Props;
        string number = props.Value.ToString("0.###", CultureInfo.InvariantCulture);
        return <div className="field">
            <span className="field-label">{Text(props.Label)}</span>
            <div className="field-track">
                <input className="field-input"
                    type="range"
                    value={number}
                    attributes={new()
                    {
                        ["min"] = props.Min.ToString("0.###", CultureInfo.InvariantCulture),
                        ["max"] = props.Max.ToString("0.###", CultureInfo.InvariantCulture),
                        ["step"] = props.Step.ToString("0.###", CultureInfo.InvariantCulture),
                    }}
                    onInput={props.OnInput} />
            </div>
            <span className="field-value">{Text(Ui.Format(props.Value) + props.Suffix)}</span>
        </div>;
    }
}