using System;
using System.Net.Http;
using System.Threading.Tasks;
using Donkeh.Hosting;
using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>
/// The contextual tool options row: what the active tool can do, plus the current
/// foreground and background colours.
/// </summary>
public sealed class OptionsBar : Component
{
    /// <inheritdoc/>
    public override Node Render()
    {
        PaintSession editor = UseContext(EditorContext.Value);

        return <div className="optionsbar">
            <div className="tool-badge">
                {Ui.Icon(Icons.ForTool(editor.Tool), "tool-badge-icon", Icons.IsRegular(editor.Tool))}
                <span className="tool-badge-name">{Text(PaintSession.NameOf(editor.Tool))}</span>
                <span className="tool-badge-key">{Text(PaintSession.ShortcutOf(editor.Tool))}</span>
            </div>
            <div className="opt-sep" />
            <div className="options-group">{Options(editor)}</div>
            <div className="options-spacer" />
            <div className="color-block">
                <div className="color-pair">
                    {Ui.Tip(editor,
                        Ui.Swatch("color-chip-back", editor.Background, "Background colour — click to swap", editor.SwapColors, 22, 22),
                        Icons.Palette, "Background Colour", "tab.colour")}
                    {Ui.Tip(editor,
                        Ui.Swatch("color-chip-front", editor.Foreground, "Foreground colour — click to open the colour panel", editor.OpenColourTab, 22, 22),
                        Icons.Palette, "Foreground Colour", "tab.colour")}
                </div>
                <div className="color-actions">
                    {Ui.Tip(editor,
                        Ui.IconButton(Icons.Swap, "Swap foreground and background (X)", editor.SwapColors, className: "icon-btn is-tiny"),
                        Icons.Swap, "Swap Colours", "", "X")}
                    {Ui.Tip(editor,
                        <button className="icon-btn is-tiny"
                            Title="Default black and white (D)"
                            OnClick={editor.ResetColors}>
                            {<DefaultsGlyph />}
                        </button>,
                        Icons.Invert, "Default Colours", "", "D")}
                </div>
            </div>
        </div>;
    }

    /// <summary>Explains what the active selection tool does.</summary>
    private static string SelectionNote(PaintTool tool) => tool switch
    {
        PaintTool.EllipseSelect => "Drag an ellipse; paint inside it, or drag it with the Move tool",
        PaintTool.Lasso => "Draw a freehand outline; it closes when you release",
        _ => "Drag a rectangle, then paint inside it or drag it with the Move tool",
    };

    /// <summary>Builds one text alignment toggle.</summary>
    private static Node AlignButton(PaintSession editor, TextAlign align, string icon, string title)
    {
        string helpId = align switch
        {
            TextAlign.Left => "options.alignLeft",
            TextAlign.Center => "options.alignCenter",
            _ => "options.alignRight",
        };

        return Ui.Tip(editor, <button className={editor.TextAlignment == align ? "btn is-on" : "btn"}
            Title={title}
            OnClick={() =>
            {
                editor.SetTextAlign(align);
                editor.Refresh?.Invoke();
            }}>
            {Ui.Icon(icon, "align-glyph")}
        </button>, icon, title, helpId);
    }

    /// <summary>Downloads a cdnfonts family on a worker thread and adds it on the frame thread.</summary>
    private static void StartFontImport(PaintSession editor)
    {
        if (!editor.BeginFontImport())
        {
            editor.Refresh?.Invoke();
            return;
        }

        string input = editor.FontUrl;
        editor.Refresh?.Invoke();
        Task.Run(() =>
        {
            try
            {
                TextFont font = FontCatalog.Import(input);
                Host.Post(() =>
                {
                    editor.CompleteFontImport(font);
                    editor.Refresh?.Invoke();
                });
            }
            catch (Exception ex)
            {
                string message = ex is HttpRequestException { StatusCode: { } status }
                    ? $"cdnfonts returned {(int)status}. Check the font name or URL."
                    : ex.Message;
                Host.Post(() =>
                {
                    editor.FailFontImport(message);
                    editor.Refresh?.Invoke();
                });
            }
        });
    }

    /// <summary>Builds the normal text-tool controls.</summary>
    private static Node TextOptions(PaintSession editor) => F(
        <TextField
            Value={editor.TextContent}
            Placeholder="Type your text"
            onInput={editor.SetText}
            onFocus={editor.BeginTyping}
            onBlur={editor.EndTyping}
            key={"text-" + editor.TextGeneration} />,
        <div className="text-font">
            <button className={editor.IsFontMenuOpen ? "btn font-picker is-on" : "btn font-picker"}
                Title="Choose a font"
                OnClick={() =>
                {
                    editor.ToggleFontMenu();
                    editor.Refresh?.Invoke();
                }}>
                <span className="font-picker-name">{Text(editor.Font.Name)}</span>
                {Ui.Icon(Icons.ChevronDown, "font-picker-arrow")}
            </button>
        </div>,
        Ui.Tip(editor,
            Ui.IconButton(Icons.Plus, "Add a font from cdnfonts", () =>
            {
                editor.ToggleFontAdd();
                editor.Refresh?.Invoke();
            }, className: "icon-btn is-tiny"),
            Icons.Plus, "Add Font", "options.addFont"),
        <Field Label="Size" Value={editor.TextSize} Min={8f} Max={200f} Step={1f} Suffix=" px"
            onInput={value => { editor.SetTextSize(Ui.Parse(value, 8f, 200f)); editor.Refresh?.Invoke(); }} />,
        <div className="segmented">
            {Ui.Tip(editor, Ui.Toggle("B", "Bold text", editor.TextBold, () =>
            {
                editor.ToggleTextBold();
                editor.Refresh?.Invoke();
            }), Icons.Text, "Bold", "options.bold")}
            {Ui.Tip(editor, Ui.Toggle("I", "Italic text", editor.TextItalic, () =>
            {
                editor.ToggleTextItalic();
                editor.Refresh?.Invoke();
            }), Icons.Text, "Italic", "options.italic")}
        </div>,
        <div className="segmented">
            {AlignButton(editor, TextAlign.Left, Icons.AlignLeft, "Align left")}
            {AlignButton(editor, TextAlign.Center, Icons.AlignCenter, "Centre")}
            {AlignButton(editor, TextAlign.Right, Icons.AlignRight, "Align right")}
        </div>,
        Ui.Tip(editor, <button className={editor.IsTextFxOpen ? "btn is-on" : "btn"}
            Title="Outline, shadow and glow effects"
            OnClick={() =>
            {
                editor.ToggleTextFx();
                editor.Refresh?.Invoke();
            }}>
            {Ui.Icon(Icons.Sparkles, "btn-icon")}
            {Text("FX")}
        </button>, Icons.Sparkles, "Text Effects", "options.fx"),
        Ui.Tip(editor, Ui.Swatch("text-color-chip", editor.Foreground, "Text colour - click to open the colour panel", editor.OpenColourTab, 22, 22),
            Icons.Palette, "Text Colour", "tab.colour"),
        <Toggle Label="Text layer" title="Keep the text editable as a text layer" Active={editor.TextAsLayer}
            onClick={() => { editor.TextAsLayer = !editor.TextAsLayer; editor.Refresh?.Invoke(); }} />,
        Ui.Tip(editor, Ui.Button("Place", "Commit the text (Enter)", () =>
        {
            editor.ApplyText();
            editor.Refresh?.Invoke();
        }), Icons.Text, "Place Text", "options.place", "Enter"),
        Ui.Tip(editor, Ui.Button("Cancel", "Discard the text", () =>
        {
            editor.CancelText();
            editor.Refresh?.Invoke();
        }), Icons.Close, "Cancel Text", "options.cancel"));

    /// <summary>Builds the compact font-import row shown in place of the text options.</summary>
    private static Node ImportOptions(PaintSession editor) => F(
        <span className="options-note">{Text("Import a font from cdnfonts")}</span>,
        <TextField
            Value={editor.FontUrl}
            Placeholder="cdnfonts URL or font name"
            onInput={editor.SetFontUrl}
            onFocus={editor.BeginTyping}
            onBlur={editor.EndTyping}
            onCommit={_ => StartFontImport(editor)}
            key={"font-url-" + editor.FontAddGeneration}
            ClassName="font-url" />,
        Ui.Button("Add", "Download and cache this font", () => StartFontImport(editor), !editor.IsFontDownloading),
        Ui.Button("Cancel", "Close the font import row", editor.CancelFontAdd, !editor.IsFontDownloading),
        Show(editor.FontImportMessage.Length > 0,
            <span className={editor.FontImportFailed
                    ? "font-import-status is-error"
                    : editor.IsFontDownloading
                        ? "font-import-status is-busy"
                        : "font-import-status"}>
                {Text(editor.FontImportMessage)}
            </span>));

    /// <summary>Builds the controls that belong to the active tool.</summary>
    private static Node Options(PaintSession editor) => editor.Tool switch
    {
        PaintTool.Brush or PaintTool.Eraser => F(
            <Field Label="Size" Value={editor.BrushSize} Min={1f} Max={120f} Step={1f} Suffix=" px"
                onInput={value => { editor.BrushSize = Ui.Parse(value, 1f, 120f); editor.Refresh?.Invoke(); }} />,
            <Field Label="Hardness" Value={editor.Hardness * 100f} Min={0f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Hardness = Ui.Parse(value, 0f, 100f) / 100f; editor.Refresh?.Invoke(); }} />,
            <Field Label="Opacity" Value={editor.Opacity * 100f} Min={5f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Opacity = Ui.Parse(value, 5f, 100f) / 100f; editor.Refresh?.Invoke(); }} />),

        PaintTool.CloneStamp or PaintTool.HealingBrush => F(
            <Field Label="Size" Value={editor.BrushSize} Min={1f} Max={120f} Step={1f} Suffix=" px"
                onInput={value => { editor.BrushSize = Ui.Parse(value, 1f, 120f); editor.Refresh?.Invoke(); }} />,
            <Field Label="Hardness" Value={editor.Hardness * 100f} Min={0f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Hardness = Ui.Parse(value, 0f, 100f) / 100f; editor.Refresh?.Invoke(); }} />,
            <Field Label="Opacity" Value={editor.Opacity * 100f} Min={5f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Opacity = Ui.Parse(value, 5f, 100f) / 100f; editor.Refresh?.Invoke(); }} />,
            <span className="options-note">
                {Text(editor.HasCloneSource
                    ? $"Source {editor.CloneSourceX}, {editor.CloneSourceY} — Ctrl-click to move it"
                    : "Ctrl-click to set the sample source")}
            </span>),

        PaintTool.DodgeBurn => F(
            <div className="segmented">
                {Ui.Toggle("Dodge", "Lighten with brush strokes", editor.DodgeMode, () =>
                {
                    editor.DodgeMode = true;
                    editor.Refresh?.Invoke();
                })}
                {Ui.Toggle("Burn", "Darken with brush strokes", !editor.DodgeMode, () =>
                {
                    editor.DodgeMode = false;
                    editor.Refresh?.Invoke();
                })}
            </div>,
            <Field Label="Size" Value={editor.BrushSize} Min={1f} Max={120f} Step={1f} Suffix=" px"
                onInput={value => { editor.BrushSize = Ui.Parse(value, 1f, 120f); editor.Refresh?.Invoke(); }} />,
            <Field Label="Hardness" Value={editor.Hardness * 100f} Min={0f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Hardness = Ui.Parse(value, 0f, 100f) / 100f; editor.Refresh?.Invoke(); }} />,
            <Field Label="Strength" Value={editor.Opacity * 100f} Min={5f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Opacity = Ui.Parse(value, 5f, 100f) / 100f; editor.Refresh?.Invoke(); }} />),

        PaintTool.Line => F(
            <Field Label="Weight" Value={editor.BrushSize} Min={1f} Max={120f} Step={1f} Suffix=" px"
                onInput={value => { editor.BrushSize = Ui.Parse(value, 1f, 120f); editor.Refresh?.Invoke(); }} />,
            <Field Label="Opacity" Value={editor.Opacity * 100f} Min={5f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Opacity = Ui.Parse(value, 5f, 100f) / 100f; editor.Refresh?.Invoke(); }} />,
            Ui.Toggle("Shape layer", "Create an editable shape layer", editor.ShapeAsLayer, () =>
            {
                editor.ShapeAsLayer = !editor.ShapeAsLayer;
                editor.Refresh?.Invoke();
            })),

        PaintTool.Rectangle or PaintTool.Ellipse => F(
            <div className="segmented">
                {<Toggle Label="Fill" title="Fill the shape" Active={editor.FillShapes} onClick={() => { editor.FillShapes = true; editor.Refresh?.Invoke(); }} />}
                {<Toggle Label="Stroke" title="Outline the shape" Active={!editor.FillShapes} onClick={() => { editor.FillShapes = false; editor.Refresh?.Invoke(); }} />}
            </div>,
            <Field Label="Width" Value={editor.StrokeWidth} Min={1f} Max={40f} Step={1f} Suffix=" px"
                onInput={value => { editor.StrokeWidth = Ui.Parse(value, 1f, 40f); editor.Refresh?.Invoke(); }} />,
            <Field Label="Opacity" Value={editor.Opacity * 100f} Min={5f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Opacity = Ui.Parse(value, 5f, 100f) / 100f; editor.Refresh?.Invoke(); }} />,
            <Toggle Label="Shape layer" title="Create an editable shape layer" Active={editor.ShapeAsLayer}
                onClick={() => { editor.ShapeAsLayer = !editor.ShapeAsLayer; editor.Refresh?.Invoke(); }} />),

        PaintTool.Gradient => F(
            <Field Label="Opacity" Value={editor.Opacity * 100f} Min={5f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Opacity = Ui.Parse(value, 5f, 100f) / 100f; editor.Refresh?.Invoke(); }} />,
            <span className="options-note">{Text("Drag from the foreground to the background colour")}</span>),

        PaintTool.Bucket => F(
            <Field Label="Tolerance" Value={editor.Tolerance} Min={0f} Max={128f} Step={1f} Suffix={string.Empty}
                onInput={value => { editor.Tolerance = (int)Ui.Parse(value, 0f, 128f); editor.Refresh?.Invoke(); }} />,
            <Field Label="Opacity" Value={editor.Opacity * 100f} Min={5f} Max={100f} Step={1f} Suffix=" %"
                onInput={value => { editor.Opacity = Ui.Parse(value, 5f, 100f) / 100f; editor.Refresh?.Invoke(); }} />),

        PaintTool.Marquee or PaintTool.EllipseSelect or PaintTool.Lasso => F(
            <span className="options-note">{Text(SelectionNote(editor.Tool))}</span>,
            Ui.Tip(editor, Ui.Button("Select all", "Select the whole document", editor.SelectAll),
                Icons.Marquee, "Select All", "options.selectAll"),
            Ui.Tip(editor, Ui.Button("Deselect", "Clear the selection (Esc)", editor.Deselect, editor.Selection is not null),
                Icons.Close, "Deselect", "options.deselect", "Esc")),

        PaintTool.MagicWand => F(
            <Field Label="Tolerance" Value={editor.MagicTolerance} Min={0f} Max={128f} Step={1f} Suffix={string.Empty}
                onInput={value => { editor.MagicTolerance = (int)Ui.Parse(value, 0f, 128f); editor.Refresh?.Invoke(); }} />,
            <Toggle Label="Contiguous" title="Only select the connected region" Active={editor.MagicContiguous}
                onClick={() => { editor.MagicContiguous = !editor.MagicContiguous; editor.Refresh?.Invoke(); }} />,
            <span className="options-note">{Text("Selects colours on the active layer")}</span>,
            Ui.Tip(editor, Ui.Button("Select all", "Select the whole document", editor.SelectAll),
                Icons.Marquee, "Select All", "options.selectAll"),
            Ui.Tip(editor, Ui.Button("Deselect", "Clear the selection (Esc)", editor.Deselect, editor.Selection is not null),
                Icons.Close, "Deselect", "options.deselect", "Esc")),

        PaintTool.QuickSelect => F(
            <Field Label="Size" Value={editor.BrushSize} Min={1f} Max={120f} Step={1f} Suffix=" px"
                onInput={value => { editor.BrushSize = Ui.Parse(value, 1f, 120f); editor.Refresh?.Invoke(); }} />,
            <Field Label="Tolerance" Value={editor.QuickTolerance} Min={0f} Max={128f} Step={1f} Suffix={string.Empty}
                onInput={value => { editor.QuickTolerance = (int)Ui.Parse(value, 0f, 128f); editor.Refresh?.Invoke(); }} />,
            <Toggle Label="Subtract" title="Remove the sampled region from the selection" Active={editor.QuickSubtract}
                onClick={() => { editor.ToggleQuickSubtract(); editor.Refresh?.Invoke(); }} />,
            <span className="options-note">{Text("Drag over an object; hold Alt to subtract")}</span>,
            Ui.Tip(editor, Ui.Button("Deselect", "Clear the selection (Esc)", editor.Deselect, editor.Selection is not null),
                Icons.Close, "Deselect", "options.deselect", "Esc")),

        PaintTool.Move => F(
            <span className="options-note">{Text("Drag to move the selection, or a handle to resize it. With no selection, drag moves the layer.")}</span>,
            <Button Label="Deselect" title="Clear the selection (Esc)" onClick={editor.Deselect} Enabled={editor.Selection is not null} />),

        PaintTool.Text => editor.IsFontAddOpen ? ImportOptions(editor) : TextOptions(editor),

        PaintTool.Pen => F(
            <div className="segmented">
                {<Toggle Label="Fill" title="Fill the path" Active={editor.FillShapes} onClick={() => { editor.FillShapes = true; editor.Refresh?.Invoke(); }} />}
                {<Toggle Label="Stroke" title="Outline the path" Active={!editor.FillShapes} onClick={() => { editor.FillShapes = false; editor.Refresh?.Invoke(); }} />}
            </div>,
            <Field Label="Width" Value={editor.StrokeWidth} Min={1f} Max={40f} Step={1f} Suffix=" px"
                onInput={value => { editor.StrokeWidth = Ui.Parse(value, 1f, 40f); editor.Refresh?.Invoke(); }} />,
            <span className="options-note">{Text("Click to add points; click the first point or press Enter to close")}</span>,
            Ui.Button("Finish", "Close the path", editor.FinishPenPath, editor.IsPenActive),
            Ui.Button(
                editor.IsPathNodeEditing ? "Nodes On" : "Edit Nodes",
                "Drag the selected path layer's anchors and handles",
                editor.TogglePathNodeEdit,
                editor.CanEditPathNodes || editor.IsPathNodeEditing),
            Show(editor.IsPathNodeEditing, Ui.Button(
                "Add Node",
                "Insert a node after the selected one",
                editor.AddPathNode,
                editor.SelectedPathNode >= 0)),
            Show(editor.IsPathNodeEditing, Ui.Button(
                "Delete Node",
                "Remove the selected path node",
                editor.DeleteSelectedPathNode,
                editor.SelectedPathNode >= 0)),
            Show(editor.IsPathNodeEditing, Ui.Button(
                "Done",
                "Finish editing path nodes",
                editor.EndPathNodeEdit))),

        PaintTool.Eyedropper => <span className="options-note">{Text("Click anywhere to sample the composited colour")}</span>,

        _ => <span className="options-note">{Text("Click to zoom in, right-click to zoom out")}</span>,
    };
}