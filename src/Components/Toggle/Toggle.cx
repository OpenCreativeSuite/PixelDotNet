using Donkeh.UILab;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>
/// A two-state toggle button that applies the <c>is-on</c> class when active.
/// </summary>
/// <example>
/// <code>
/// &lt;Toggle Label="Bold" title="Bold text" Active={editor.TextBold} onClick={() => editor.ToggleTextBold()} /&gt;
/// </code>
/// </example>
public class ToggleProps : Props
{
    /// <summary>Gets or sets the button label.</summary>
    /// <value>The label text. Defaults to an empty string.</value>
    public string Label { get; set; } = "";

    /// <summary>Gets or sets the native <c>title</c> attribute.</summary>
    /// <value>The title text. Defaults to an empty string.</value>
    public string title { get; set; } = "";

    /// <summary>Gets or sets whether the toggle is in the active (on) state.</summary>
    /// <value><see langword="true"/> when active; applies the <c>is-on</c> class.</value>
    public bool Active { get; set; }

    /// <summary>Gets or sets the click handler invoked on activation.</summary>
    /// <value>An action, or <see langword="null"/>.</value>
    public Action? onClick { get; set; }
}

/// <summary>
/// A two-state toggle component. See <see cref="ToggleProps"/> for the available props.
/// </summary>
public sealed class Toggle : Component<ToggleProps>
{
    /// <inheritdoc/>
    public override Node Render()
    {
        ToggleProps props = Props;
        return <button className={props.Active ? "btn is-on" : "btn"}
            title={props.title}
            onClick={() => props.onClick?.Invoke()}>
            {Text(props.Label)}
        </button>;
    }
}