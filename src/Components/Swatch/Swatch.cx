using Donkeh.LayoutLab;
using Donkeh.UILab;
using Donkeh.Windowing;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>
/// A small square colour swatch rendered as a canvas painted with a single colour.
/// </summary>
/// <example>
/// <code>
/// &lt;Swatch ClassName="swatch" Color={color} title="Use this colour" onClick={() => pick(color)} Width={18} Height={18} /&gt;
/// </code>
/// </example>
public class SwatchProps : Props
{
    /// <summary>Gets or sets the colour to paint (packed ARGB).</summary>
    /// <value>The colour value.</value>
    public uint Color { get; set; }

    /// <summary>Gets or sets the swatch width in pixels.</summary>
    /// <value>The width. Defaults to 24.</value>
    public int Width { get; set; } = 24;

    /// <summary>Gets or sets the swatch height in pixels.</summary>
    /// <value>The height. Defaults to 18.</value>
    public int Height { get; set; } = 18;
}

/// <summary>
/// A colour swatch component. See <see cref="SwatchProps"/> for the available props.
/// </summary>
public sealed class Swatch : Component<SwatchProps>
{
    /// <inheritdoc/>
    public override Node Render()
    {
        SwatchProps props = Props;
        return <canvas className={props.ClassName ?? "swatch"}
            title={props.Title}
            attributes={Ui.Size(props.Width, props.Height)}
            onClick={() => props.OnClick?.Invoke()}
            onCanvasDraw={(Action<CanvasContext>)(context => context.Clear(Ui.RgbaOpaque(props.Color)))} />;
    }
}