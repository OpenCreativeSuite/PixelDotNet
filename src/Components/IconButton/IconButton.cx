using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>
/// A square icon-only button rendering a Font Awesome glyph.
/// </summary>
/// <example>
/// <code>
/// &lt;IconButton Icon={Icons.Save} title="Save" onClick={editor.Save} Enabled={editor.CanSave} ClassName="quick-btn" /&gt;
/// </code>
/// </example>
public class IconButtonProps : Props
{
    /// <summary>Gets or sets the Font Awesome icon class.</summary>
    /// <value>The icon class. Defaults to an empty string.</value>
    public string Icon { get; set; } = "";

    /// <summary>Gets or sets whether the button is enabled.</summary>
    /// <value><see langword="true"/> (default) enables the button.</value>
    public bool Enabled { get; set; } = true;

    /// <summary>Gets or sets whether to use the regular (outline) weight for the glyph.</summary>
    /// <value><see langword="true"/> for regular weight.</value>
    public bool Regular { get; set; }
}

/// <summary>
/// An icon button component. See <see cref="IconButtonProps"/> for the available props.
/// </summary>
public sealed class IconButton : Component<IconButtonProps>
{
    /// <inheritdoc/>
    public override Node Render()
    {
        IconButtonProps props = Props;
        string baseClassName = props.ClassName ?? "icon-btn";
        string baseClass = baseClassName == "icon-btn" ? "icon-btn" : $"icon-btn {baseClassName}";
        string classes = props.Enabled ? baseClass : baseClass + " is-disabled";
        return <button className={classes}
            title={props.Title}
            disabled={!props.Enabled}
            onClick={() => props.OnClick?.Invoke()}>
            {Ui.Icon(props.Icon, regular: props.Regular)}
        </button>;
    }
}