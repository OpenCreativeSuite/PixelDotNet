using System;
using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>One-shot colour operations: balance, threshold, gradient map, replace and split.</summary>
public sealed class ColourToolsDialog : Component
{
    private static readonly string[] BalanceLabels =
    [
        "Shadows: cyan / red",
        "Shadows: magenta / green",
        "Shadows: yellow / blue",
        "Midtones: cyan / red",
        "Midtones: magenta / green",
        "Midtones: yellow / blue",
        "Highlights: cyan / red",
        "Highlights: magenta / green",
        "Highlights: yellow / blue",
    ];

    /// <inheritdoc/>
    public override Node Render()
    {
        PaintSession editor = UseContext(EditorContext.Value);
        if (!editor.IsColourToolsOpen)
        {
            return <span />;
        }

        return <div className="resize-layer">
            <div className="resize-panel style-panel colour-tools-panel">
                <div className="resize-head">
                    <span className="resize-head-icon">{Ui.Icon(Icons.Palette)}</span>
                    <div className="resize-head-titles">
                        <span className="resize-title">{Text("Colour Tools")}</span>
                        <span className="resize-sub">{Text("Apply to the active layer or selection.")}</span>
                    </div>
                    {Ui.Tip(editor,
                        Ui.IconButton(Icons.Close, "Close", () =>
                        {
                            editor.CloseColourToolsDialog();
                            editor.Refresh?.Invoke();
                        }, className: "icon-btn"),
                        Icons.Close, "Close", "")}
                </div>
                <div className="style-body">
                    {Section(
                        "Colour Balance",
                        "Apply",
                        "Shift shadows, midtones and highlights on each axis.",
                        editor.ApplyColourBalance,
                        BalanceRows(editor))}
                    {Section(
                        "Threshold",
                        "Apply",
                        "Turn the layer into pure black and white at the chosen level.",
                        editor.ApplyThreshold,
                        Ui.Slider("Level", editor.ThresholdLevel, 0f, 255f, 1f, string.Empty, value =>
                        {
                            editor.SetThresholdLevel(value);
                            editor.Refresh?.Invoke();
                        }))}
                    {Section(
                        "Gradient Map",
                        "Apply",
                        "Map luminance between two colours.",
                        editor.ApplyGradientMap,
                        <div className="style-rows">
                            {Colors(editor, "Dark", editor.GradientLow, editor.SetGradientLow)}
                            {Colors(editor, "Light", editor.GradientHigh, editor.SetGradientHigh)}
                        </div>)}
                    {Section(
                        "Replace Colour",
                        "Apply",
                        "Replace pixels close to one colour; tolerance widens the match.",
                        editor.ApplyColourReplace,
                        <div className="style-rows">
                            {Colors(editor, "From", editor.ReplaceFrom, editor.SetReplaceFrom, includeDocument: true)}
                            {Colors(editor, "To", editor.ReplaceTo, editor.SetReplaceTo, includeDocument: true)}
                            {Ui.Slider("Tolerance", editor.ReplaceTolerance, 0f, 255f, 1f, string.Empty, value =>
                            {
                                editor.SetReplaceTolerance(value);
                                editor.Refresh?.Invoke();
                            })}
                        </div>)}
                    {Section(
                        "Red-Eye Removal",
                        "Apply",
                        "Neutralise red pupils inside the selection.",
                        editor.ApplyRedEye,
                        Ui.Slider("Strength", editor.RedEyeStrength, 0f, 100f, 1f, " %", value =>
                        {
                            editor.SetRedEyeStrength(value);
                            editor.Refresh?.Invoke();
                        }))}
                    {Section(
                        "Channel Mixer",
                        "Apply",
                        "Each output channel is a weighted sum of the source channels.",
                        editor.ApplyChannelMix,
                        MixRows(editor))}
                    {Section(
                        "Selective Colour",
                        "Apply",
                        "Pick a colour range, then shift its cyan, magenta, yellow or black.",
                        editor.ApplySelectiveColour,
                        SelectiveRows(editor))}
                    <div className="style-section">
                        <div className="style-section-head">
                            <span className="style-section-title">{Text("Split Channels")}</span>
                            {Ui.Button("Split", "Create red, green and blue layers", () =>
                            {
                                editor.ApplySplitChannels();
                                editor.Refresh?.Invoke();
                            })}
                        </div>
                        <span className="resize-note">{Text("Adds three grayscale layers above the active layer.")}</span>
                    </div>
                </div>
                <div className="resize-foot">
                    <span className="resize-note">{Text("Each action is undoable and respects the selection.")}</span>
                    <div className="resize-actions">
                        {Ui.Button("Done", "Close the colour tools", () =>
                        {
                            editor.CloseColourToolsDialog();
                            editor.Refresh?.Invoke();
                        })}
                    </div>
                </div>
            </div>
        </div>;
    }

    /// <summary>Builds a titled section with an Apply button.</summary>
    private static Node Section(
        string title,
        string action,
        string note,
        Action apply,
        Node content) =>
        <div className="style-section">
            <div className="style-section-head">
                <span className="style-section-title">{Text(title)}</span>
                {Ui.Button(action, "Apply " + title, apply)}
            </div>
            <span className="resize-note">{Text(note)}</span>
            {content}
        </div>;

    /// <summary>Builds the nine colour-balance sliders.</summary>
    private static Node BalanceRows(PaintSession editor)
    {
        Node[] rows = new Node[BalanceLabels.Length];
        for (int i = 0; i < rows.Length; i++)
        {
            int index = i;
            rows[i] = Ui.Slider(
                BalanceLabels[i],
                editor.BalanceValue(index),
                -100f,
                100f,
                1f,
                string.Empty,
                value =>
                {
                    editor.SetBalanceValue(index, Ui.Parse(value, -100f, 100f));
                    editor.Refresh?.Invoke();
                });
        }

        return <div className="style-rows">{rows}</div>;
    }

    /// <summary>Builds the nine channel-mixer sliders.</summary>
    private static Node MixRows(PaintSession editor)
    {
        string[] labels =
        [
            "Red: from red",
            "Red: from green",
            "Red: from blue",
            "Green: from red",
            "Green: from green",
            "Green: from blue",
            "Blue: from red",
            "Blue: from green",
            "Blue: from blue",
        ];

        Node[] rows = new Node[labels.Length];
        for (int i = 0; i < labels.Length; i++)
        {
            int index = i;
            rows[i] = Ui.Slider(
                labels[i],
                editor.ChannelMixValue(index),
                -200f,
                200f,
                1f,
                " %",
                value =>
                {
                    editor.SetChannelMixValue(index, Ui.Parse(value, -200f, 200f));
                    editor.Refresh?.Invoke();
                });
        }

        Node[] all = [.. rows, Ui.Button("Reset", "Restore the identity mix", () =>
        {
            editor.ResetChannelMix();
            editor.Refresh?.Invoke();
        })];
        return <div className="style-rows">{all}</div>;
    }

    /// <summary>Builds the selective-colour range chips and CMYK sliders.</summary>
    private static Node SelectiveRows(PaintSession editor)
    {
        string[] ranges = ["Reds", "Yellows", "Greens", "Cyans", "Blues", "Magentas", "Whites", "Neutrals", "Blacks"];
        string[] channels = ["Cyan", "Magenta", "Yellow", "Black"];

        Node[] sliders = new Node[channels.Length];
        for (int i = 0; i < channels.Length; i++)
        {
            int index = i;
            sliders[i] = Ui.Slider(
                channels[i],
                editor.SelectiveValue(index),
                -100f,
                100f,
                1f,
                " %",
                value =>
                {
                    editor.SetSelectiveValue(index, Ui.Parse(value, -100f, 100f));
                    editor.Refresh?.Invoke();
                });
        }

        Node[] chips = new Node[ranges.Length];
        for (int i = 0; i < ranges.Length; i++)
        {
            int index = i;
            chips[i] = <button className={editor.SelectiveRange == index ? "btn is-on" : "btn"}
                Title={"Edit " + ranges[i]}
                OnClick={() =>
                {
                    editor.SelectSelectiveRange(index);
                    editor.Refresh?.Invoke();
                }}>
                {Text(ranges[i])}
            </button>;
        }

        Node[] all = new Node[sliders.Length + 2];
        all[0] = <div className="style-chips">{chips}</div>;
        Array.Copy(sliders, 0, all, 1, sliders.Length);
        all[^1] = Ui.Button("Reset", "Clear every selective offset", () =>
        {
            editor.ResetSelectiveColour();
            editor.Refresh?.Invoke();
        });

        return <div className="style-rows">{all}</div>;
    }

    /// <summary>Builds a labelled row of colour swatches.</summary>
    private static Node Colors(
        PaintSession editor,
        string label,
        uint current,
        Action<uint> pick,
        bool includeDocument = false) =>
        <div className="style-swatches">
            <span className="resize-label">{Text(label)}</span>
            {Each(new uint[]
            {
                0xFF000000,
                0xFFFFFFFF,
                0xFFE05454,
                0xFF4CBB6C,
                0xFF3D7BE0,
                0xFFFFD84D,
            }, color => (Node)Ui.Swatch(
                current == color ? "style-swatch is-on" : "style-swatch",
                color,
                "Use this colour",
                () => pick(color),
                18,
                18))}
            {Show(includeDocument,
                <Swatch
                    ClassName={current == editor.Foreground ? "style-swatch is-on" : "style-swatch"}
                    Color={editor.Foreground}
                    title="Use the foreground colour"
                    onClick={() => pick(editor.Foreground)}
                    Width={18}
                    Height={18} />)}
            {Show(includeDocument,
                <Swatch
                    ClassName={current == editor.Background ? "style-swatch is-on" : "style-swatch"}
                    Color={editor.Background}
                    title="Use the background colour"
                    onClick={() => pick(editor.Background)}
                    Width={18}
                    Height={18} />)}
        </div>;
}