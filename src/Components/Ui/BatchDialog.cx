using System;
using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>Resize and format conversion for a whole folder of images.</summary>
public sealed class BatchDialog : Component
{
    /// <inheritdoc/>
    public override Node Render()
    {
        PaintSession editor = UseContext(EditorContext.Value);
        if (!editor.IsBatchOpen)
        {
            return <span />;
        }

        return <div className="resize-layer">
            <div className="resize-panel batch-panel">
                <div className="resize-head">
                    <span className="resize-head-icon">{Ui.Icon(Icons.Flatten)}</span>
                    <div className="resize-head-titles">
                        <span className="resize-title">{Text("Batch Processing")}</span>
                        <span className="resize-sub">{Text("Resize and convert every image in a folder.")}</span>
                    </div>
                    {Ui.Tip(editor,
                        Ui.IconButton(Icons.Close, "Close", () =>
                        {
                            editor.CloseBatchDialog();
                            editor.Refresh?.Invoke();
                        }, className: "icon-btn"),
                        Icons.Close, "Close", "")}
                </div>
                <div className="resize-body">
                    {FolderRow(editor, "Source", editor.BatchSource, editor.BatchSetSource, scan: true)}
                    <div className="batch-places">
                        {Each(editor.BatchPlaces, place => (Node)Button(new()
                        {
                            className = "file-place",
                            Title = "Use " + place.Path,
                            OnClick = () => editor.BatchUsePlace(place),
                        }, Text(place.Label)))}
                    </div>
                    {FolderRow(editor, "Output", editor.BatchOutput, editor.BatchSetOutput, scan: false)}
                    <div className="resize-field">
                        <span className="resize-label">{Text("Scale")}</span>
                        <input className="text-field resize-input"
                            Type="text"
                            Value={editor.BatchScaleText}
                            Placeholder="100"
                            OnInput={editor.BatchSetScale} />
                        <span className="resize-unit">{Text("%")}</span>
                    </div>
                    <div className="resize-field">
                        <span className="resize-label">{Text("Suffix")}</span>
                        <input className="text-field resize-input"
                            Type="text"
                            Value={editor.BatchSuffix}
                            Placeholder="-edited"
                            OnInput={editor.BatchSetSuffix} />
                        <span className="resize-unit" />
                    </div>
                    <div className="batch-formats">
                        <span className="resize-label">{Text("Format")}</span>
                        {Each(new[]
                        {
                            ImageFormat.Png,
                            ImageFormat.Jpeg,
                            ImageFormat.Bmp,
                            ImageFormat.Tga,
                        }, format => (Node)Button(new()
                        {
                            className = editor.BatchFormat == format ? "btn is-on" : "btn",
                            Title = "Write " + ImageExporter.NameOf(format),
                            OnClick = () => editor.BatchSetFormat(format),
                        }, Text(ImageExporter.NameOf(format))))}
                        <div className="actions-spacer" />
                        {Ui.Toggle(
                            "Overwrite",
                            "Replace files that already exist",
                            editor.BatchOverwrite,
                            () => editor.ToggleBatchOverwrite())}
                    </div>
                    <div className="batch-status">{Text(editor.BatchStatus)}</div>
                </div>
                <div className="resize-foot">
                    <span className="resize-note">{Text("Name = original + suffix. Format sets the extension.")}</span>
                    <div className="resize-actions">
                        {Ui.Button("Close", "Close the batch dialog", () =>
                        {
                            editor.CloseBatchDialog();
                            editor.Refresh?.Invoke();
                        })}
                        {Ui.Button("Run", "Process the folder", () =>
                        {
                            editor.RunBatch();
                            editor.Refresh?.Invoke();
                        })}
                    </div>
                </div>
            </div>
        </div>;
    }

    /// <summary>Builds one folder path row.</summary>
    private static Node FolderRow(
        PaintSession editor,
        string label,
        string value,
        Action<string> onCommit,
        bool scan) =>
        <div className="resize-field">
            <span className="resize-label">{Text(label)}</span>
            <input className="text-field resize-input"
                Type="text"
                Value={value}
                Placeholder="Folder path; press Enter"
                OnChange={onCommit} />
            {Show(scan, Ui.Button("Scan", "Recount the source folder", editor.BatchRefreshCount))}
        </div>;
}