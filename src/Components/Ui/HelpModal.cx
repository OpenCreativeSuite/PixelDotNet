using Donkeh.UILab;
using PixelDotNet.Help;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>The centred help modal opened by a tooltip's chevron.</summary>
public sealed class HelpModal : Component
{
    /// <inheritdoc/>
    public override Node Render()
    {
        PaintSession editor = UseContext(EditorContext.Value);
        if (editor.OpenHelp is not { } topic)
        {
            return <span />;
        }

        return <div className="help-layer">
            <div className="help-panel">
                <div className="help-head">
                    <span className="help-icon-box">{Ui.Icon(topic.Icon, "help-icon")}</span>
                    <div className="help-titles">
                        <div className="help-title-row">
                            <span className="help-title">{Text(topic.Title)}</span>
                            {Show(topic.Shortcut.Length > 0, <span className="help-key">{Text(topic.Shortcut)}</span>)}
                        </div>
                        <span className="help-summary">{Text(topic.Summary)}</span>
                    </div>
                    {Ui.Tip(editor,
                        Ui.IconButton(Icons.Close, "Close help", () =>
                        {
                            editor.CloseHelp();
                            editor.Refresh?.Invoke();
                        }, className: "icon-btn help-close"),
                        Icons.Close, "Close Help", "")}
                </div>
                <div className="help-body">
                    <Section Title="How it works" Children={Lines(topic.HowItWorks)} />
                    <Section Title="Tips" Children={Tips(topic.Tips)} />
                </div>
                <div className="help-foot">
                    <span className="help-foot-note">{Text("Hover any icon to see it again.")}</span>
                    {<Button Label="Got it" title="Close this help article" onClick={() => { editor.CloseHelp(); editor.Refresh?.Invoke(); }} />}
                </div>
            </div>
        </div>;
    }

    private static Node[] Lines(string[] lines)
    {
        Node[] nodes = new Node[lines.Length];
        for (int index = 0; index < lines.Length; index++)
        {
            nodes[index] = <div className="help-line">
                <span className="help-bullet" />
                <span className="help-text">{Text(lines[index])}</span>
            </div>;
        }

        return nodes;
    }

    private static Node[] Tips(string[] tips)
    {
        Node[] nodes = new Node[tips.Length];
        for (int index = 0; index < tips.Length; index++)
        {
            nodes[index] = <div className="help-tip">
                <span className="help-tip-mark">{Ui.Icon(Icons.Sparkles)}</span>
                <span className="help-text">{Text(tips[index])}</span>
            </div>;
        }

        return nodes;
    }
}