using System;
using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>The Image Size / Canvas Size modal.</summary>
public sealed class ResizeDialog : Component
{
    /// <inheritdoc/>
    public override Node Render()
    {
        PaintSession editor = UseContext(EditorContext.Value);
        if (!editor.IsResizeOpen)
        {
            return <span />;
        }

        bool canvas = editor.ResizeIsCanvas;
        string title = canvas ? "Canvas Size" : "Image Size";
        string summary = canvas
            ? "Change the document bounds; existing pixels keep their scale."
            : "Scale every layer, mask and guide to a new pixel size.";

        return <div className="resize-layer">
            <div className="resize-panel">
                <div className="resize-head">
                    <span className="resize-head-icon">{Ui.Icon(canvas ? Icons.Marquee : Icons.Document)}</span>
                    <div className="resize-head-titles">
                        <span className="resize-title">{Text(title)}</span>
                        <span className="resize-sub">{Text(summary)}</span>
                    </div>
                    {Ui.Tip(editor,
                        Ui.IconButton(Icons.Close, "Close", () =>
                        {
                            editor.CloseResizeDialog();
                            editor.Refresh?.Invoke();
                        }, className: "icon-btn"),
                        Icons.Close, "Close", "")}
                </div>
                <div className="resize-body">
                    <div className="resize-current">{Text($"Current: {editor.ResizeOriginalWidth} × {editor.ResizeOriginalHeight} px")}</div>
                    {Field("Width", editor.ResizeWidthText, editor.ResizeSetWidth)}
                    {Field("Height", editor.ResizeHeightText, editor.ResizeSetHeight)}
                    {Ui.Toggle(
                        "Keep aspect ratio",
                        "Link the width and height",
                        editor.ResizeKeepAspect,
                        () => editor.ToggleResizeAspect())}
                    {Show(canvas, Anchors(editor))}
                    {Show(editor.ResizeError.Length > 0,
                        <div className="resize-error">{Text(editor.ResizeError)}</div>)}
                </div>
                <div className="resize-foot">
                    <span className="resize-note">{Text(canvas ? "Guides follow the anchor." : "Undo restores the previous size.")}</span>
                    <div className="resize-actions">
                        {<Button Label="Cancel" title="Close without resizing" onClick={() => { editor.CloseResizeDialog(); editor.Refresh?.Invoke(); }} />}
                        {<Button Label="Resize" title="Apply the new size" onClick={() => { editor.ApplyResize(); editor.Refresh?.Invoke(); }} />}
                    </div>
                </div>
            </div>
        </div>;
    }

    /// <summary>Builds one labelled pixel field.</summary>
    private static Node Field(string label, string value, Action<string> onInput) =>
        <div className="resize-field">
            <span className="resize-label">{Text(label)}</span>
            <input className="text-field resize-input"
                Type="text"
                Value={value}
                Placeholder="pixels"
                OnInput={onInput} />
            <span className="resize-unit">{Text("px")}</span>
        </div>;

    /// <summary>Builds the 3x3 anchor picker used by canvas resize.</summary>
    private static Node Anchors(PaintSession editor) =>
        <div className="resize-anchor-block">
            <span className="resize-label">{Text("Anchor")}</span>
            <div className="resize-anchor-grid">
                {AnchorRow(editor, ResizeAnchor.TopLeft, ResizeAnchor.Top, ResizeAnchor.TopRight)}
                {AnchorRow(editor, ResizeAnchor.Left, ResizeAnchor.Center, ResizeAnchor.Right)}
                {AnchorRow(editor, ResizeAnchor.BottomLeft, ResizeAnchor.Bottom, ResizeAnchor.BottomRight)}
            </div>
        </div>;

    /// <summary>Builds one row of three anchor buttons.</summary>
    private static Node AnchorRow(
        PaintSession editor,
        ResizeAnchor first,
        ResizeAnchor second,
        ResizeAnchor third) =>
        <div className="resize-anchor-row">
            {AnchorButton(editor, first)}
            {AnchorButton(editor, second)}
            {AnchorButton(editor, third)}
        </div>;

    /// <summary>Builds one anchor choice.</summary>
    private static Node AnchorButton(PaintSession editor, ResizeAnchor anchor) =>
        <button className={editor.ResizeAnchor == anchor ? "resize-anchor is-on" : "resize-anchor"}
            Title={"Anchor " + anchor}
            OnClick={() => editor.SetResizeAnchor(anchor)}>
            <span className="resize-anchor-dot" />
        </button>;
}