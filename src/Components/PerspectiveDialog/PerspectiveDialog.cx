using System;
using Donkeh.UILab;
using PixelDotNet.Paint;
using static Donkeh.UILab.HtmlHelper;
using static Donkeh.UILab._;

namespace PixelDotNet.Components;

/// <summary>
/// Modal dialog for a four-corner perspective transform with a live canvas preview
/// and per-corner offset sliders.
/// </summary>
/// <remarks>
/// Renders nothing when <see cref="PaintSession.IsPerspectiveOpen"/> is false or no
/// layer is being transformed.
/// </remarks>
public sealed class PerspectiveDialog : Component
{
    private static readonly string[] Labels =
    [
        "Top left X",
        "Top left Y",
        "Top right X",
        "Top right Y",
        "Bottom right X",
        "Bottom right Y",
        "Bottom left X",
        "Bottom left Y",
    ];

    /// <inheritdoc/>
    public override Node Render()
    {
        PaintSession editor = UseContext(EditorContext.Value);
        if (!editor.IsPerspectiveOpen || editor.PerspectiveLayer is not { } layer)
        {
            return <span />;
        }

        Node[] sliders = new Node[Labels.Length];
        for (int i = 0; i < sliders.Length; i++)
        {
            int index = i;
            sliders[i] = Ui.Slider(
                Labels[i],
                editor.PerspectiveValue(index),
                -300f,
                300f,
                1f,
                " px",
                value =>
                {
                    editor.SetPerspectiveValue(index, Ui.Parse(value, -300f, 300f));
                    editor.Refresh?.Invoke();
                });
        }

        return <div className="resize-layer">
            <div className="resize-panel style-panel perspective-panel">
                <div className="resize-head">
                    <span className="resize-head-icon">{Ui.Icon(Icons.Move)}</span>
                    <div className="resize-head-titles">
                        <span className="resize-title">{Text("Perspective Transform")}</span>
                        <span className="resize-sub">{Text(layer.Name)}</span>
                    </div>
                    {Ui.Tip(editor,
                        Ui.IconButton(Icons.Close, "Cancel", () =>
                        {
                            editor.CancelPerspective();
                            editor.Refresh?.Invoke();
                        }, className: "icon-btn"),
                        Icons.Close, "Cancel", "")}
                </div>
                <div className="style-body">
                    <span className="resize-note">
                        {Text(editor.Selection is null
                            ? "Drag the corners by moving the sliders; the layer is transformed live."
                            : "Transforms the selected region; pixels outside it stay put.")}
                    </span>
                    <div className="style-rows">{sliders}</div>
                </div>
                <div className="resize-foot">
                    <span className="resize-note">{Text("Reset returns to the original pixels.")}</span>
                    <div className="resize-actions">
                        {<Button Label="Reset" title="Clear all corner offsets" onClick={() => { editor.ResetPerspective(); editor.Refresh?.Invoke(); }} />}
                        {<Button Label="Cancel" title="Restore the original pixels" onClick={() => { editor.CancelPerspective(); editor.Refresh?.Invoke(); }} />}
                        {<Button Label="Done" title="Keep the transformed layer" onClick={() => { editor.CommitPerspective(); editor.Refresh?.Invoke(); }} />}
                    </div>
                </div>
            </div>
        </div>;
    }
}